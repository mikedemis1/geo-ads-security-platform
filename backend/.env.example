# Copy to backend/.env and replace every CHANGE_ME. The app refuses to start
# if any of the required values is missing, and JWT_SECRET must be at least
# 32 bytes.

# Required
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_STRING_OF_AT_LEAST_32_BYTES
ADMIN_TOKEN_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_STRING_OF_32_BYTES
ADMIN_USER=admin
ADMIN_PASS=CHANGE_ME
DB_PASSWORD=CHANGE_ME   # same value as POSTGRES_PASSWORD in the root .env

# Optional, defaults shown
DB_HOST=localhost
DB_PORT=5433
DB_NAME=geo_ads
DB_USER=geo_ads_user
JWT_ISSUER=geo-ads
JWT_AUDIENCE=geo-ads-ui
JWT_DEFAULT_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=86400
CRYPTO_MODE=HMAC_SHA256   # or HMAC_SHA3_256
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
